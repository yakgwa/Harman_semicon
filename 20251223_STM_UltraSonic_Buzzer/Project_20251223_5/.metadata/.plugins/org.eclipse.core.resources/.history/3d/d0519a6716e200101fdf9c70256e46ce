int Read_Temperature(void)
{
    int sum = 0;
    int samples = 10;

    for(int i = 0; i < samples; i++)
    {
        HAL_ADC_Start(&hadc1);
        if(HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY) == HAL_OK)
        {
            int adc_value = HAL_ADC_GetValue(&hadc1);
            sum += adc_value;
        }
        HAL_ADC_Stop(&hadc1);
        HAL_Delay(5);  // 안정화
    }

    float avg_voltage = (sum / (float)samples) * 3.3f / 4095.0f;
    float temp = ((avg_voltage - 0.76f) / 0.0025f) + 25.0f;

    //printf("temp avg : %d C\r\n", (int)temp);
    return (int)temp;
}
