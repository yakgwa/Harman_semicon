#include <stdio.h>
#include <stdint.h>
#include <sleep.h>
#include "platform.h"
#include "xil_printf.h"

typedef struct {
    volatile uint32_t CMD;
    volatile uint32_t tx_data;
    volatile uint32_t rx_data;
    volatile uint32_t SR;
} IIC_typedef;

typedef enum {
    IDLE_CMD = 0,
    START_CMD = 1,
    STOP_CMD = 2,
    RESTART_CMD = 3,
    RD_CMD = 4,
    WR_CM = 5
} IIC_CMD;

#define IIC_BASEADDR 0x44a00000
#define IIC ((IIC_typedef *) IIC_BASEADDR)

// I2C 전송 시작 함수
void start_transmission(IIC_typedef * iic, uint32_t target_slaveNum, uint32_t start_regAddr);

// I2C 데이터 전송 함수
void write_IIC(IIC_typedef * iic, uint32_t *data);

// I2C 전송 종료 함수
void stop_transmission(IIC_typedef * iic);

int main() {
    init_platform();

    uint32_t target_slaveNum = 0b00000000;  // 슬레이브 주소
    uint32_t start_regAddr = 0b00000000;  // 시작 레지스터 주소
    uint32_t data = 100;  // 전송할 데이터 초기값 (100으로 시작)

    start_transmission(IIC, target_slaveNum, start_regAddr);
    print("Start Transmission!\n");

    // I2C로 자동 증가하는 값 전송
    write_IIC(IIC, &data);  // 첫 번째 전송 (100)
    xil_printf("Sent Value: %d\n", data);

    write_IIC(IIC, &data);  // 두 번째 전송 (101)
    xil_printf("Sent Value: %d\n", data);

    write_IIC(IIC, &data);  // 세 번째 전송 (102)
    xil_printf("Sent Value: %d\n", data);

    write_IIC(IIC, &data);  // 네 번째 전송 (103)
    xil_printf("Sent Value: %d\n", data);

    stop_transmission(IIC);
    print("Stop Transmission!\n");

    cleanup_platform();
    return 0;
}

// I2C 전송 시작 함수
void start_transmission(IIC_typedef * iic, uint32_t target_slaveNum, uint32_t start_regAddr) {
    iic->CMD = START_CMD;   // START 명령
    iic->CMD = IDLE_CMD;    // IDLE 상태로 복귀
    while (!(iic->SR & (1 << 2)));  // 전송 준비가 완료될 때까지 대기
    write_IIC(iic, &target_slaveNum);  // 슬레이브 주소 전송
    write_IIC(iic, &start_regAddr);  // 레지스터 주소 전송
}

// I2C 데이터 전송 함수
void write_IIC(IIC_typedef * iic, uint32_t *data) {
    iic->tx_data = *data;  // tx_data에 데이터 저장
    iic->CMD = WR_CM;      // WR_CM 명령 전송
    iic->CMD = IDLE_CMD;   // IDLE 상태로 복귀
    while (!(iic->SR & (1 << 2)));  // 전송 완료될 때까지 대기

    // 데이터 전송 후 증가
    (*data)++;
}

// I2C 전송 종료 함수
void stop_transmission(IIC_typedef * iic) {
    iic->CMD = STOP_CMD;   // STOP 명령
    iic->CMD = IDLE_CMD;   // IDLE 상태로 복귀
    while (!(iic->SR & (1 << 2)));  // 전송 완료될 때까지 대기
}
