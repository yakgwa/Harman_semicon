#include "millis.h"

uint32_t m_counter = 0;
Timer_TypeDef *millsTimer;

void Millis_Init(Timer_TypeDef *tmr)
{
	millsTimer = tmr;
	TMR_SetPSC(millsTimer, 100000); // 1ms 간격으로 count + 1 (1K - 1)
	TMR_SetARR(millsTimer, 0xffffffff-1);
	TMR_Start(millsTimer);
}


void incMillis() {
	m_counter++;
}

void clearMillis() {
	m_counter = 0;
}

void setMillis(uint32_t t) {
	m_counter = t;
}

uint32_t millis() {
	//return m_counter;
	return TMR_ReadCNT(millsTimer);
}
