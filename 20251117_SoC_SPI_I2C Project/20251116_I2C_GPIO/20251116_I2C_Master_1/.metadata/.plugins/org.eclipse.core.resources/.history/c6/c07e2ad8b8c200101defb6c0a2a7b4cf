#include <stdio.h>
#include <stdint.h>
#include <sleep.h>
#include "platform.h"
#include "xil_printf.h"

typedef struct {
   volatile uint32_t CMD;
   volatile uint32_t tx_data;
   volatile uint32_t rx_data;
   volatile uint32_t SR;
} IIC_typedef;

typedef enum {
   IDLE_CMD = 0,
   START_CMD = 1,
   STOP_CMD = 2,
   RESTART_CMD = 3,
   RD_CMD = 4,
   WR_CM = 5
} IIC_CMD;

#define IIC_BASEADDR 0x44a00000
#define IIC ((IIC_typedef *) IIC_BASEADDR)

#define BUTTON_PRESSED 1
#define BUTTON_RELEASED 0

void start_transmission(IIC_typedef * iic, uint32_t target_slaveNum, uint32_t start_regAddr);
void write_IIC(IIC_typedef * iic, uint32_t data);
void stop_transmission(IIC_typedef * iic);

int main() {
   init_platform();

   uint32_t target_slaveNum = 0b00000000;
   uint32_t start_regAddr = 0b00000000;

   int button_state = BUTTON_RELEASED;  // 초기 버튼 상태는 RELEASED
   uint32_t counter = 100;  // 카운터 시작 값을 100으로 설정
   int prev_button_state = BUTTON_RELEASED;  // 이전 버튼 상태

   while (1) {
      // 버튼 상태 읽기 (예시로 GPIO에서 읽는 코드로 가정)
      // 실제로 버튼 입력을 받아오는 코드 필요 (GPIO 상태 확인)
      // button_state = read_button_state(); // 버튼 상태를 읽는 함수

      // 버튼이 눌린 상태에서만 동작
      if (button_state == BUTTON_PRESSED && prev_button_state == BUTTON_RELEASED) {
         // 버튼이 눌렸을 때, start_transmission 호출
         start_transmission(IIC, target_slaveNum, start_regAddr);
         print("Start Transmission!\n");

         // 현재 카운터 값을 I2C로 전송
         write_IIC(IIC, counter);
         print("Sent Value: ");
         xil_printf("%d\n", counter);  // 전송된 값 출력

         // 카운터 증가
         counter++;

         // I2C 전송 후, Stop Transmission
         stop_transmission(IIC);
         print("Stop Transmission!\n");

         // 버튼이 눌린 상태에서 한번만 실행되도록 버튼 상태를 RELEASED로 설정
         prev_button_state = BUTTON_PRESSED;  // 버튼을 눌렀다는 상태로 설정
      } else if (button_state == BUTTON_RELEASED) {
         prev_button_state = BUTTON_RELEASED;  // 버튼이 RELEASED 상태일 때
      }

      // 버튼이 떼어졌을 때 다시 버튼을 눌러서 작동시킬 수 있도록 대기
      usleep(100000);  // 짧은 지연을 넣어 중복 입력을 방지
   }

   cleanup_platform();
   return 0;
}

void start_transmission(IIC_typedef * iic, uint32_t target_slaveNum, uint32_t start_regAddr) {
   iic->CMD = START_CMD;
   iic->CMD = IDLE_CMD;
   while (!(iic->SR & (1 << 2)));  // 상태 레지스터 확인
   write_IIC(iic, target_slaveNum);
   write_IIC(iic, start_regAddr);
}

void write_IIC(IIC_typedef * iic, uint32_t data) {
   iic->tx_data = data;
   iic->CMD = WR_CM;
   iic->CMD = IDLE_CMD;
   while (!(iic->SR & (1 << 2)));  // 상태 레지스터 확인
}

void stop_transmission(IIC_typedef * iic) {
   iic->CMD = STOP_CMD;
   iic->CMD = IDLE_CMD;
   while (!(iic->SR & (1 << 2)));  // 상태 레지스터 확인
}
