void write_IIC(IIC_typedef * iic, uint32_t data) {
    static uint32_t counter = 100;  // 카운터를 static 변수로 정의하여 함수 호출 간에 값을 유지

    // 현재 카운터 값을 전송할 데이터로 설정
    *data = counter;

    // 데이터 전송
    iic->tx_data = *data;
    iic->CMD = WR_CM;
    iic->CMD = IDLE_CMD;

    // 전송 후 카운터 증가
    counter++;  // 버튼이 눌릴 때마다 값이 증가

    // I2C 전송 완료 대기
    while (!(iic->SR & (1 << 2)));  // 상태 레지스터 확인
}


void stop_transmission(IIC_typedef * iic) {
   iic->CMD = STOP_CMD;
   iic->CMD = IDLE_CMD;
   while (!(iic->SR & (1 << 2)));
}
