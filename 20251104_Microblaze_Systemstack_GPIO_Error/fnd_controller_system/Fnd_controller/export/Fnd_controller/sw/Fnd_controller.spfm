<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="Fnd_controller"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
Fnd_controller
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="Fnd_controller">
        <sdx:configuration sdx:name="Fnd_controller"
                           sdx:displayName="Fnd_controller"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>Fnd_controller</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="Fnd_controller/boot/Fnd_controller.bif"
                            sdx:readme="Fnd_controller/boot/generic.readme"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone_domain"
                                sdx:cpuType="microblaze_0"
                                sdx:cpuInstance="microblaze_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="Fnd_controller/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="Fnd_controller/standalone_domain/bspinclude/include"
                        sdx:bspConfig="Fnd_controller/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
