#include "powerind.h"
hLed powerLed;

void initPowerInd()
{
	LED_Init(&powerLed, LED_GPIO, LED_0)
}

void disPowerInd()
{
	static uint32_t prevTime = 0;
	uint32_t curTime = millis();

	if(curTime - prevTime >= 500) retrun;
	prevTime = curTime;

	LED_Toggle(&powerLed);
}
